{
    "name": "asmit/fila-calendar",
    "description": "A polished inline calendar form field for Filament.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Asmit Nepali",
            "email": "asmit@thefireflytech.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0|^5.0",
        "filament/infolists": "^4.0|^5.0",
        "illuminate/support": "^11.0|^12.0",
        "nesbot/carbon": "^2.72|^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Asmit\\FilaCalendar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asmit\\FilaCalendar\\FilaCalendarServiceProvider"
            ]
        }
    },
    "options": {
        "symlink": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
