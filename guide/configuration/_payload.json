ting records\nsitting on those dates keep saving.",[427,1467,1469],{"id":1468},"range-colors","Range colors",[56,1471,1472,1473,1476],{},"Override range selection colors from the host app theme by setting CSS variables on ",[60,1474,1475],{},".fi-fila-calendar"," (or a parent). Defaults match the built-in teal palette.",[56,1478,1479,1480,463,1483,1486,1487,1490,1491,1495,1496,1499,1500,1503],{},"Use Filament's runtime palette variables (",[60,1481,1482],{},"--primary-500",[60,1484,1485],{},"--primary-600",", …) injected on ",[60,1488,1489],{},":root",". Do ",[1492,1493,1494],"strong",{},"not"," use ",[60,1497,1498],{},"--color-primary-500"," here — that name is a Tailwind ",[60,1501,1502],{},"@theme inline"," alias for utility classes and is not available to arbitrary CSS.",[69,1505,1507],{"className":977,"code":1506,"language":979,"meta":74,"style":74},".fi-fila-calendar {\n    --fi-fila-calendar-range-start-bg: var(--primary-500);\n    --fi-fila-calendar-range-start-color: white;\n    --fi-fila-calendar-range-end-bg: var(--primary-600);\n    --fi-fila-calendar-range-end-color: white;\n    --fi-fila-calendar-range-middle-bg: color-mix(in oklab, var(--primary-500) 18%, transparent);\n    --fi-fila-calendar-range-middle-color: var(--primary-600);\n    --fi-fila-calendar-range-middle-hover-bg: color-mix(in oklab, var(--primary-500) 28%, transparent);\n}\n",[60,1508,1509,1517,1532,1544,1559,1570,1609,1624,1658],{"__ignoreMap":74},[78,1510,1511,1513,1515],{"class":80,"line":81},[78,1512,67],{"class":92},[78,1514,988],{"class":149},[78,1516,991],{"class":92},[78,1518,1519,1522,1524,1526,1528,1530],{"class":80,"line":116},[78,1520,1521],{"class":88},"    --fi-fila-calendar-range-start-bg",[78,1523,974],{"class":92},[78,1525,1001],{"class":155},[78,1527,159],{"class":92},[78,1529,1482],{"class":88},[78,1531,425],{"class":92},[78,1533,1534,1537,1539,1542],{"class":80,"line":139},[78,1535,1536],{"class":88},"    --fi-fila-calendar-range-start-color",[78,1538,974],{"class":9