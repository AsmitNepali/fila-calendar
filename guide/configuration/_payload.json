 icon.",[947,961,962,964],{},[60,963,623],{}," — recurring blocked weekdays. Muted style.",[56,966,967],{},"None of them can be clicked, so none can start or end a range. A range drawn over them stays one continuous range, and the blocked days inside it are highlighted as part of the range instead of showing the blocked style — reserved days keep their icon either way, so a booking conflict stays visible inside a range.",[56,969,970,971,974],{},"The marker uses the panel's primary color on plain days and stays white on days filled by a range\nselection. Override the color per theme with ",[60,972,973],{},"--fi-fila-calendar-reserved-color",":",[69,976,980],{"className":977,"code":978,"language":979,"meta":74,"style":74},"language-css shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".fi-fila-calendar {\n    --fi-fila-calendar-reserved-color: var(--danger-500);\n}\n","css",[60,981,982,992,1009],{"__ignoreMap":74},[78,983,984,986,989],{"class":80,"line":81},[78,985,67],{"class":92},[78,987,988],{"class":149},"fi-fila-calendar",[78,990,991],{"class":92}," {\n",[78,993,994,997,999,1002,1004,1007],{"class":80,"line":116},[78,995,996],{"class":88},"    --fi-fila-calendar-reserved-color",[78,998,974],{"class":92},[78,1000,1001],{"class":155}," var",[78,1003,159],{"class":92},[78,1005,1006],{"class":88},"--danger-500",[78,1008,425],{"class":92},[78,1010,1011],{"class":80,"line":139},[78,1012,1013],{"class":92},"}\n",[1015,1016,1018],"h3",{"id":1017},"choosing-the-icon","Choosing the icon",[56,1020,1021,1022,1024,1025,1027,1028,1031],{},"The icon defaults to ",[60,1023,602],{},". Pass a ",[60,1026,598],{}," — every case of Filament's\n",[60,1029,1030],{},"Heroicon"," enum is one — and Filament picks the variant that fits the rendered size:",[69,1033,1035],{"className":71,"code":1034,"language":73,"meta":74,"style":74},"use Asmit\\FilaCalendar\\Forms\\Components\\CalendarInput;\nuse Filament\\Support\\Icons\\Heroicon;\n\nCalendarInput::make('